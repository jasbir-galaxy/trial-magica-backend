            {
              "type": "select",
              "dataType": "string",
              "default": "none",
              "label": "Transition",
              "options": [
                {
                  "value": "none",
                  "label": "None"
                },
                {
                  "value": "fade",
                  "label": "Fade"
                },
                {
                  "value": "dissolve",
                  "label": "Dissolve"
                }
              ],
              "helpText": "Transition effect between videos",
              "zodExpectedName": "transition"
            }
          ],
          "inputSchema": {
            "type": "object",
            "properties": {
              "video_urls": {
                "minItems": 2,
                "maxItems": 100,
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "transition": {
                "default": "none",
                "type": "string",
                "enum": [
                  "none",
                  "fade",
                  "dissolve"
                ]
              }
            },
            "required": [
              "video_urls"
            ]
          }
        }
      ]
