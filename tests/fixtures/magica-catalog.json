{
  "version": 1,
  "models": {
    "crop_image": {
      "nodeType": "crop_image",
      "subModels": [
        {
          "subModelId": "crop_image",
          "inputFieldOptions": [
            {
              "type": "image",
              "dataType": "string",
              "default": "",
              "label": "Input Image",
              "maxImages": 1,
              "required": true,
              "helpText": "Upload an image to crop",
              "zodExpectedName": "image_url"
            },
            {
              "type": "slider",
              "dataType": "number",
              "default": 0,
              "label": "X Position (%)",
              "min": 0,
              "max": 100,
              "step": 1,
              "helpText": "Horizontal crop start position (percentage from left)",
              "zodExpectedName": "x_percent"
            },
            {
              "type": "slider",
              "dataType": "number",
              "default": 0,
              "label": "Y Position (%)",
              "min": 0,
              "max": 100,
              "step": 1,
              "helpText": "Vertical crop start position (percentage from top)",
              "zodExpectedName": "y_percent"
            },
            {
              "type": "slider",
              "dataType": "number",
              "default": 100,
              "label": "Width (%)",
              "min": 0,
              "max": 100,
              "step": 0.001,
              "helpText": "Crop width as a percentage of the original image",
              "zodExpectedName": "width_percent"
            },
            {
              "type": "slider",
              "dataType": "number",
              "default": 100,
              "label": "Height (%)",
              "min": 0,
              "max": 100,
              "step": 0.001,
              "helpText": "Crop height as a percentage of the original image",
              "zodExpectedName": "height_percent"
            },
            {
              "type": "number",
              "dataType": "number",
              "default": null,
              "label": "Width (px)",
              "min": 1,
              "step": 1,
              "isAdvanced": true,
              "skipExecutionDefault": true,
              "helpText": "Exact crop width in pixels. When width and height are set without X/Y, the crop is centered.",
              "zodExpectedName": "width_px"
            },
            {
              "type": "number",
              "dataType": "number",
              "default": null,
              "label": "Height (px)",
              "min": 1,
              "step": 1,
              "isAdvanced": true,
              "skipExecutionDefault": true,
              "helpText": "Exact crop height in pixels. When width and height are set without X/Y, the crop is centered.",
              "zodExpectedName": "height_px"
            },
            {
              "type": "number",
              "dataType": "number",
              "default": null,
              "label": "X Position (px)",
              "min": 0,
              "step": 1,
              "isAdvanced": true,
              "skipExecutionDefault": true,
              "helpText": "Optional exact crop start position from the left. Leave empty to center pixel crops.",
              "zodExpectedName": "x_px"
            },
            {
              "type": "number",
              "dataType": "number",
              "default": null,
              "label": "Y Position (px)",
              "min": 0,
              "step": 1,
              "isAdvanced": true,
              "skipExecutionDefault": true,
              "helpText": "Optional exact crop start position from the top. Leave empty to center pixel crops.",
              "zodExpectedName": "y_px"
            }
          ],
          "inputSchema": {
            "type": "object",
            "properties": {
              "image_url": {
                "type": "string",
                "format": "uri"
              },
              "crop": {
                "type": "object",
                "properties": {
                  "x": {
                    "nullable": true,
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "y": {
                    "nullable": true,
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "width": {
                    "nullable": true,
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "height": {
                    "nullable": true,
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  }
                }
              },
              "x_px": {
                "nullable": true,
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "y_px": {
                "nullable": true,
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "width_px": {
                "nullable": true,
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "height_px": {
                "nullable": true,
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "x_percent": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "y_percent": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "width_percent": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "height_percent": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            },
            "required": [
              "image_url"
            ]
