{
  "name": "magica-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm db:generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "pnpm db:generate",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:check": "node --conditions=react-server --import tsx scripts/check-database.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "test:db": "vitest run --config vitest.integration.config.ts",
    "agent:check": "tsx scripts/check-agent-setup.ts",
    "trigger:dev": "trigger dev --profile magica-work-trial --env-file .env.local",
    "uploads:check": "node --conditions=react-server --import tsx scripts/check-upload-setup.ts",
    "docs:generate": "tsx scripts/export-openapi.ts",
    "docs:check": "tsx scripts/export-openapi.ts --check",
    "deploy:check": "tsx scripts/check-deployment.ts",
    "trigger:deploy": "trigger deploy --profile magica-work-trial --env prod --env-file .env.release.local",
    "test:migrations": "node scripts/check-fresh-migrations.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1158.0",
    "@aws-sdk/s3-request-presigner": "^3.1158.0",
    "@clerk/backend": "3.26.2",
    "@next/env": "16.4.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@trigger.dev/sdk": "4.8.1",
    "eventsource-parser": "^4.1.3",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@trigger.dev/build": "4.8.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prisma": "^7.10.1",
    "trigger.dev": "4.8.1",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.15.0"
}
