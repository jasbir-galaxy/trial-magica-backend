FRONTEND_ORIGIN=http://localhost:3000
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
DATABASE_URL=postgresql://magica:magica_local_only@127.0.0.1:5433/magica_trial?schema=public

# Optional direct connection for hosted migrations (Neon also supplies DATABASE_URL_UNPOOLED).
DIRECT_URL=

# Agent services: backend only; use the Development environment locally.
OPENROUTER_API_KEY=
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=
# Only this model route is allowed; no paid fallback.
OPENROUTER_MODEL=openrouter/free

# Trial media tools. Server-only; use the supplied trial key.
MAGICA_API_BASE_URL=https://inference.magica.com
MAGICA_API_KEY=

# Application-only trial allocation for newly created credit accounts (default 0).
TRIAL_INITIAL_CREDITS=1000000

# File uploads: backend and Trigger worker only. Community plan; no paid overage.
TRANSLOADIT_PLAN=community
TRANSLOADIT_AUTH_KEY=
TRANSLOADIT_AUTH_SECRET=
# A private S3-compatible bucket. Do not use public-read ACLs.
UPLOAD_S3_ENDPOINT=
UPLOAD_S3_REGION=
UPLOAD_S3_BUCKET=
UPLOAD_S3_ACCESS_KEY_ID=
UPLOAD_S3_SECRET_ACCESS_KEY=
UPLOAD_S3_PROVIDER=s3
UPLOAD_S3_FORCE_PATH_STYLE=false
# Optional deployed HTTPS API origin for signed completion webhooks.
UPLOAD_PUBLIC_API_ORIGIN=

# Stable 32-byte base64 master for per-endpoint webhook signatures. Backend/worker only.
WEBHOOK_MASTER_KEY=

# Canonical backend HTTPS origin for the deployed OpenAPI server URL.
PUBLIC_API_BASE_URL=
